    {
      "name": "get_credit_balance",
      "title": "Get credit balance",
      "description": "Returns how many credits remain in the connected MusVideo account. Credits cannot be bought or added from ChatGPT; if the user asks how to get more, say they can't be added here, without links, plans or prices. Do not advise whether or when to change subscriptions, including waiting or changing them later. Do not infer subscriptions, renewal dates, refills or future credit grants.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "creditsRemaining": {
            "type": "integer"
          }
        },
        "required": [
          "creditsRemaining"
        ]
      },
      "annotations": {
        "title": "Get credit balance",
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false,
        "idempotentHint": true
      },
      "securitySchemes": [
        {
          "type": "oauth2",
          "scopes": [
            "mv.read"
          ]
        }
      ],
      "_meta": {
        "securitySchemes": [
          {
            "type": "oauth2",
            "scopes": [
              "mv.read"
            ]
          }
        ],
        "openai/toolInvocation/invoking": "Checking your credits…",
        "openai/toolInvocation/invoked": "Credits checked"
      }
    },
    {
      "name": "import_song",
      "title": "Import a song",
      "description": "Imports a song to use for a music video: either an audio file the user attached in ChatGPT (`file`) or a public link (`audioUrl`: a direct MP3/WAV/M4A/FLAC/OGG link or a public Suno song page). Exactly one of the two. Limits: up to 50 MB, longer than 5 seconds and at most 10 minutes. YouTube links are not supported. Copies the audio into the user's MusVideo storage; costs no credits. Returns a songId for create_mv_project. Only import music the user has the right to use.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "file": {
            "type": "object",
            "description": "Audio file attached in ChatGPT.",
            "properties": {
              "download_url": {
                "type": "string"
              },
              "file_id": {
                "type": "string"
              },
              "mime_type": {
                "type": "string"
              },
              "file_name": {
                "type": "string"
              }
            },
            "required": [
              "download_url",
              "file_id"
            ]
          },
          "audioUrl": {
            "type": "string",
            "description": "Public https link to an audio file or a public Suno song page.",
            "maxLength": 2000
          },
          "title": {
            "type": "string",
            "description": "Optional song title.",
            "maxLength": 200
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "songId": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "durationSec": {
            "type": "number"
          }
        },
        "required": [
          "songId",
          "title",
          "durationSec"
        ]
      },
      "annotations": {
        "title": "Import a song",
        "readOnlyHint": false,
        "destructiveHint": false,
        "openWorldHint": true
      },
      "securitySchemes": [
        {
          "type": "oauth2",
          "scopes": [
            "mv.create"
          ]
        }
      ],
      "_meta": {
        "securitySchemes": [
          {
            "type": "oauth2",
            "scopes": [
              "mv.create"
            ]
          }
        ],
        "openai/toolInvocation/invoking": "Importing your song…",
        "openai/toolInvocation/invoked": "Song imported",
        "openai/fileParams": [
          "file"
        ]
      }
    },
    {
      "name": "create_mv_project",
      "title": "Create a music video project",
      "description": "Creates a MusVideo project from an imported song and starts listening to the song and drafting a story for the video. Costs 6 credits (song analysis and story). Spends credits from the user's MusVideo account: before calling, tell the user the cost and get explicit confirmation in the chat. Story preparation runs in the background for a few minutes; afterwards call get_mv_progress to show the story and ask the user to approve it. Pass a fresh requestId; calling again with the same requestId returns the same project instead of a duplicate, while calling without one may create a duplicate project. MusVideo does not create sexual or adult content, content that sexualizes or targets minors, or videos depicting real public figures or celebrities; decline those requests instead of calling this tool.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "songId"
        ],
        "properties": {
          "songId": {
            "type": "string",
            "description": "songId from import_song."
          },
          "stylePrompt": {
            "type": "string",
            "maxLength": 2000,
            "description": "The look, mood, setting or story idea the user wants, in their words."
          },
          "aspectRatio": {
            "type": "string",
            "enum": [
              "16:9",
              "9:16"
            ],
            "default": "16:9",
            "description": "16:9 landscape (default) or 9:16 vertical."
          },
          "title": {
            "type": "string",
            "maxLength": 200
          },
          "requestId": {
            "type": "string",
            "maxLength": 100,
            "description": "Unique id for this request, reused on retries."
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "projectId": {
            "type": "integer"
          },
          "operationId": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "chargedCredits": {
            "type": "integer"
          }
        },
        "required": [
          "projectId",
          "status"
        ]
      },
      "annotations": {
        "title": "Create a music video project",
        "readOnlyHint": false,
        "destructiveHint": false,
        "openWorldHint": false
      },
      "securitySchemes": [
        {
          "type": "oauth2",
          "scopes": [
            "mv.create"
          ]
        }
      ],
      "_meta": {
        "securitySchemes": [
          {
            "type": "oauth2",
            "scopes": [
              "mv.create"
            ]
          }
        ],
        "openai/toolInvocation/invoking": "Starting your music video…",
        "openai/toolInvocation/invoked": "Story in progress",
        "ui": {
          "resourceUri": "ui://musvideo/mv-card.html"
        },
        "openai/outputTemplate": "ui://musvideo/mv-card.html",
        "openai/widgetAccessible": true
      }
    },
    {
      "name": "get_mv_progress",
      "title": "Get music video progress",
      "description": "Shows where a MusVideo project is: preparing the story, story waiting for approval (includes the story text), creating the storyboard, storyboard ready, rendering (percent and finished scene thumbnails), needs credits, failed, or completed (video link). Read-only.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "projectId"
        ],
        "properties": {
          "projectId": {
            "type": "integer",
            "minimum": 1,
            "description": "MusVideo project id returned by create_mv_project or list_my_videos."
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "projectId": {
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "stage": {
            "type": "string",
            "enum": [
              "draft",
              "preparing_story",
              "story_ready",
              "creating_storyboard",
              "storyboard_ready",
              "rendering",
              "needs_credits",
              "render_failed",
              "completed",
              "failed",
              "website_only"
            ]
          },
          "percent": {
            "type": "integer"
          },
          "message": {
            "type": "string"
          },
          "aspectRatio": {
            "type": "string"
          },
          "storyProposal": {
            "type": [
              "object",
              "null"
            ]
          },
          "scenes": {
            "type": "array"
          },
          "sceneCount": {
            "type": "integer"
          },
          "videoUrl": {
            "type": [
              "string",
              "null"
            ]
          },
          "posterUrl": {
            "type": [
              "string",
              "null"
            ]
          },
          "projectPageUrl": {
            "type": "string"
          },
          "render": {
            "type": [
              "object",
              "null"
            ]
          }
        },
        "required": [
          "projectId",
          "title",
          "stage",
          "percent",
          "message"
        ]
      },
      "annotations": {
        "title": "Get music video progress",
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false,
        "idempotentHint": true
      },
      "securitySchemes": [
        {
          "type": "oauth2",
          "scopes": [
