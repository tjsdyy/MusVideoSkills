        "type": "object",
        "additionalProperties": false,
        "required": [
          "projectId"
        ],
        "properties": {
          "projectId": {
            "type": "integer",
            "minimum": 1,
            "description": "MusVideo project id returned by create_mv_project or list_my_videos."
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "quoteId",
          "totalCredits",
          "creditsRemaining",
          "sufficient"
